TZ=America/Mexico_City
LOG_LEVEL=INFO

# LLM — VLM remoto (gateway OpenAI-compatible)
VLM_ENDPOINT=http://<IP_DGX>:8003/v1/chat/completions
VLM_MODEL=<MODEL_ALIAS>

# Motion-gated scheduling
VLM_MIN_INTERVAL_S=30
VLM_MAX_INTERVAL_S=120
VLM_MOTION_THRESHOLD=0.04

# Retención
SNAPSHOT_PERIODIC_S=600
RETENTION_INTERVAL_S=3600
RETENTION_MAX_EVENTS=200000
RETENTION_MAX_SNAPSHOT_GB=50
RETENTION_MAX_AGE_DAYS=30
